        "value": "#!/usr/bin/env python3\n# create_template_master.py\n# Tạo PPTX template (master-like) với named placeholders cho Zones (A1,A2,B1,B2,C,D,E)\n# Yêu cầu: pip install python-pptx\nfrom pptx import Presentation\nfrom pptx.util import Inches, Pt\nfrom pptx.dml.color import RGBColor\nimport os\n\nOUT = \"PDS_Academic_Cultural_Master.pptx\"\nprs = Presentation()\nprs.slide_width = Inches(13.333)   # 16:9\nprs.slide_height = Inches(7.5)\n\nblank = prs.slide_layouts[6]\nslide = prs.slides.add_slide(blank)\n\n# Helper to add named placeholder rectangle (visual guide)\ndef add_zone_rect(slide, left, top, width, height, name, color=(200,200,200), alpha=0.08, label=None):\n    shp = slide.shapes.add_shape(\n        1, Inches(left), Inches(top), Inches(width), Inches(height)\n    )\n    shp.name = name\n    fill = shp.fill\n    fill.solid()\n    fill.fore_color.rgb = RGBColor(*color)\n    fill.fore_color.alpha = int(alpha*100000) if hasattr(fill.fore_color, 'alpha') else 0\n    shp.line.color.rgb = RGBColor(200,200,200)\n    shp.line.width = Pt(0.5)\n    if label:\n        tx = shp.text_frame\n        tx.text = label\n        p = tx.paragraphs[0]\n        p.font.size = Pt(10)\n    # make shape semi-transparent visual guide; user can delete later\n    return shp\n\n# Create named zones roughly matching DPS percentages (units in inches)\nW = 13.333; H = 7.5\n# Zone A1 (top-left) ~ x 0-22% y 0-14%\nadd_zone_rect(slide, left=0.1, top=0.1, width=W*0.22, height=H*0.14, name=\"zone-A1\", label=\"Zone A1 (corner top-left)\")\n# Zone A2 (top-right)\nadd_zone_rect(slide, left=W*(1-0.22)-0.1, top=0.1, width=W*0.22, height=H*0.14, name=\"zone-A2\", label=\"Zone A2 (corner top-right)\")\n# Zone B1 (bottom-left)\nadd_zone_rect(slide, left=0.1, top=H*(1-0.28), width=W*0.22, height=H*0.28, name=\"zone-B1\", label=\"Zone B1 (bottom-left)\")\n# Zone B2 (bottom-right)\nadd_zone_rect(slide, left=W*(1-0.22)-0.1, top=H*(1-0.28), width=W*0.22, height=H*0.28, name=\"zone-B2\", label=\"Zone B2 (bottom-right)\")\n# Zone C (baseline full-width)\nadd_zone_rect(slide, left=0.05, top=H*(0.85), width=W-0.1, height=H*0.15, name=\"zone-C\", label=\"Zone C (baseline)\")\n# Add a central content card (Zone D / card boundary)\nadd_zone_rect(slide, left=W*0.12, top=H*0.18, width=W*0.76, height=H*0.60, name=\"zone-card\", label=\"Zone D: Content Card (place content here)\")\n# Zone E (background): entire slide (we won't draw full bg to keep visible)\nadd_zone_rect(slide, left=0.0, top=0.0, width=W, height=H, name=\"zone-E\", color=(240,230,210), label=\"Zone E (background texture area)\")\n\n# Add title placeholder example\ntitle_box = slide.shapes.add_textbox(Inches(1.0), Inches(0.3), Inches(10.5), Inches(0.9))\ntitle_box.text_frame.text = \"MASTER TEMPLATE — PDS Academic & Cultural\"\ntitle_box.text_frame.paragraphs[0].font.size = Pt(24)\n\n# Save template\nprs.save(OUT)\nprint(\"Saved template:\", OUT)\nprint(\"Open in PowerPoint and Save As .potx if you want a true template file.\")",
