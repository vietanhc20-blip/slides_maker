        "value": "#!/usr/bin/env python3\nimport os, zipfile\nFILES = [\"PDS_Academic_Cultural_Master.pptx\",\"decor_metadata.json\",\"create_template_master.py\",\"create_sample_assets.py\",\"create_pptx.py\",\"apply_animations_win_com.py\",\"animation_plan.md\"]\nASSETS_DIR = \"assets\"\nOUTZIP = \"PDS_package_01-10-2025.zip\"\nwith zipfile.ZipFile(OUTZIP, \"w\", zipfile.ZIP_DEFLATED) as z:\n    for f in FILES:\n        if os.path.exists(f):\n            z.write(f)\n    if os.path.exists(ASSETS_DIR):\n        for root,_,files in os.walk(ASSETS_DIR):\n            for fn in files:\n                z.write(os.path.join(root,fn))\nprint(\"Created\", OUTZIP)",
