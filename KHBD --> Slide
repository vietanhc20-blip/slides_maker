kground\",\n            \"button set game\"\n        ],\n        \"education\": [\n            \"classroom poster illustration\",\n            \"school project presentation\",\n            \"students working together illustration\",\n            \"washi tape pattern\"\n        ],\n        \"preschool\": [\n            \"cute kids illustration\",\n            \"animal mascot vector\",\n            \"pastel classroom illustration\",\n            \"star cloud pattern\"\n        ],\n        \"environment\": [\n            \"forest restoration illustration\",\n            \"green eco background\",\n            \"natural landscape vector\",\n            \"leaf pattern\",\n            \"sustainable environment illustration\"\n        ]\n    }\n\n    spec = {\n        \"document_summary\": {\n            \"word_count\": len(text.split()),\n            \"keyword_candidates\": kw,\n            \"audience\": audience,\n            \"type_detected\": theme\n        },\n        \"design_spec\": {\n            \"theme\": theme,\n            \"theme_label\": cfg[\"label\"],\n            \"palette\": cfg[\"palette\"],\n            \"fonts\": cfg[\"fonts\"],\n            \"layout_pattern\": cfg[\"layout\"],\n            \"mood\": cfg[\"mood\"],\n            \"slide_count\": slide_count,\n            \"structure\": structure,\n            \"decor\": cfg[\"decor\"],\n            \"decor_placement\": {\n                \"A\": \"góc trên: mây, cành, cờ, hoa, line art nhẹ\",\n                \"B\": \"góc dưới: mascot, hình nền, rương, cây, điểm neo\",\n                \"C\": \"dải đáy: thảm cỏ, sóng biển, gạch, đường nền\",\n                \"D\": \"viền khung: washi tape, ghim, cánh hoa, lá đè lên viền\",\n                \"E\": \"nền chìm: mây mờ, giấy xước, line art, pattern\"\n            },\n            \"readability_rules\": [\n                \"Không nhồi chữ; tối đa 6 bullet/slide\",\n                \"Nền và chữ phải tương phản rõ\",\n                \"Focus card phải có màu nổi