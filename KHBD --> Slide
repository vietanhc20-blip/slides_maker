      "content": "Dưới đây là bộ 3 file bạn cần. Lưu tên tương ứng và chạy theo thứ tự:\n\n1. `decor_generator.py`\n2. `theme_selector.py`\n3. `auto_layout_generator.py`\n\nMỗi file phụ thuộc vừa đủ:\n- `theme_selector.py` đọc văn bản / file Word / PDF, phân loại topic, trả về `theme + confidence + design spec`.\n- `decor_generator.py` sinh nền và decor hình dạng abstract để lấp chỗ thiếu hình ảnh.\n- `auto_layout_generator.py` nhận JSON spec, render 6–12 slide bằng `python-pptx` theo theme tương ứng.\n\n1) decor_generator.py\n```python\n#!/usr/bin/env python3\n\"\"\"\ndecor_generator.py\nSinh nền và hình trang trí abstract cho các theme:\n- heritage_report\n- travel\n- literature\n- game\n- education\n- preschool\n- environment\n\nTác dụng:\n- nếu thiếu ảnh thật thì tự sinh abstract shapes từ SVG-like geometry\n- tự tạo zone decor ở A/B/C/D/E\n- giúp layout đẹp và không rỗng\n\"\"\"\n\nfrom pptx import Presentation\nfrom pptx.util import Inches, Pt\nfrom pptx.dml.color import RGBColor\nfrom pptx.enum.shapes import MSO_SHAPE\n\nTHEMES = {\n    \"heritage_report\": {\n        \"bg\": (245, 242, 235),    # paper\n        \"bg2\": (233, 220, 206),\n        \"panel\": (250, 248, 245),\n        \"accent\": (128, 38, 29),  # deep red\n        \"accent2\": (186, 130, 87), # gold\n        \"text\": (32, 24, 20),\n        \"title\": (86, 47, 34),\n        \"line\": (196, 157, 112)\n    },\n    \"travel\": {\n        \"bg\": (232, 243, 234),\n        \"bg2\": (208, 228, 204),\n        \"panel\": (248, 249, 246),\n        \"accent\": (82, 118, 93),\n        \"accent2\": (213, 184, 125),\n        \"text\": (24, 35, 22),\n        \"title\": (52, 81, 63),\n        \"line\": (163, 186, 136)\n    },\n    \"literature\": {\n        \"bg\": (242, 235, 228),\n        \"bg2\": (214, 201, 184),\n        \"panel\": (249, 244, 238),\n        \"accent\": (109, 44, 37),\n        \"accent2\": (184, 142, 99),\n        \"text\": (41, 27, 22),\n        \"title\": (90, 42, 30),\n        \"line\": (188, 148, 112)\n    },\n    \"game\": {\n        \"bg\": (195, 225, 255),\n        \"bg2\": (222, 240, 255),\n        \"panel\": (255, 255, 255),\n        \"accent\": (255, 178, 52),\n        \"accent2\": (36, 123, 214),\n        \"text\": (22, 30, 40),\n        \"title\": (29, 56, 118),\n        \"line\": (120, 170, 220)\n    },\n    \"education\": {\n        \"bg\": (244, 234, 170),\n        \"bg2\": (232, 247, 201),\n        \"panel\": (255, 255, 255),\n        \"accent\": (94, 157, 82),\n        \"accent2\": (254, 198, 90),\n        \"text\": (28, 38, 32),\n        \"title\": (89, 116, 57),\n        \"line\": (170, 200, 120)\n    },\n    \"preschool\": {\n        \"bg\": (223, 245, 208),\n        \"bg2\": (248, 244, 230),\n        \"panel\": (255,255,255),\n        \"accent\": (255, 154, 164),\n        \"accent2\": (252, 212, 102),\n        \"text\": (40, 41, 41),\n        \"title\": (96, 146, 125),\n        \"line\": (173, 213, 160)\n    },\n    \"environment\": {\n        \"bg\": (227, 238, 228),\n        \"bg2\": (201, 219, 192),\n        \"panel\": (246, 250, 246),\n        \"accent\": (45, 89, 42),\n        \"accent2\": (234, 168, 62),\n        \"text\": (26, 40, 29),\n        \"title\": (42, 84, 48),\n        \"line\": (155, 184, 144)\n    }\n}\n\ndef rgb(t):\n    return RGBColor(t[0], t[1], t[2])\n\ndef add_panel(slide, left, top, w, h, fill, line, radius=16):\n    shp = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, left, top, w, h)\n    shp.fill.solid()\n    shp.fill.fore_color.rgb = rgb(fill)\n    shp.line.color.rgb = rgb(line)\n    shp.line.width = Pt(1.2)\n    return shp\n\ndef add_circle(slide, cx, cy, r, fill, line):\n    shape = slide.shapes.add_shape(MSO_SHAPE.OVAL, cx, cy, r*2, r*2)\n    shape.fill.solid()\n    shape.fill.fore_color.rgb = rgb(fill)\n    shape.line.color.rgb = rgb(line)\n    shape.line.width = Pt(1)\n    return shape\n\ndef add_leaf(slide, x, y, w, h, fill, line):\n    # simple leaf shape\n    shp = slide.shapes.add_shape(MSO_SHAPE.OVAL, x, y, w, h)\n    shp.fill.solid()\n    shp.fill.fore_color.rgb = rgb(fill)\n    shp.line.color.rgb = rgb(line)\n    shp.line.width = Pt(1)\n    return shp\n\ndef add_cloud(slide, x, y, w, h, fill, line):\n    # 3 circles cloud\n    for offset, ww, hh in [(0, w*0.35, h*0.5), (w*0.25, w*0.35, h*0.55), (w*0.5, w*0.38, h*0.5)]:\n        c = slide.shapes.add_shape(MSO_SHAPE.OVAL, x+offset, y+(h*0.18), ww, hh)\n        c.fill.solid()\n        c.fill.fore_color.rgb = rgb(fill)\n        c.line.color.rgb = rgb(line)\n        c.line.width = Pt(1)\n    return None\n\ndef add_baseline(slide, theme, y_ratio=0.88):\n    palette = THEMES[theme]\n    base = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, Inches(0), Inches(7.5*y_ratio), Inches(13.333), Inches(7.5*(1-y_ratio)))\n    base.fill.solid()\n    base.fill.fore_color.rgb = rgb(palette[\"bg2\"])\n    base.line.color.rgb = rgb(palette[\"line\"])\n    base.line.width = Pt(0.8)\n    return base\n\ndef add_corner_floral(slide, theme, cx, cy, size=1.1):\n    palette = THEMES[theme]\n    # simple floral cluster\n    for dx, dy in [(0,0), (0.25,0.1), (-0.25,0.1), (0.12,-0.25), (-0.12,-0.25)]:\n        add_leaf(slide, cx + dx*size, cy + dy*size, Inches(0.5), Inches(0.7), palette[\"accent2\"], palette[\"line\"])\n    return None\n\ndef add_background_pattern(slide, theme):\n    palette = THEMES[theme]\n    # soft background circles and rectangles\n    for i in range(6):\n        x = Inches(0.3 + i*2.0)\n        y = Inches(0.4 + (i % 3) * 1.8)\n        circle = slide.shapes.add_shape(MSO_SHAPE.OVAL, x, y, Inches(1.2), Inches(1.2))\n        circle.fill.solid()\n        circle.fill.fore_color.rgb = rgb((palette[\"bg2\"][0], palette[\"bg2\"][1], palette[\"bg2\"][2]))\n        circle.fill.transparency = 0.6\n        circle.line.color.rgb = rgb((palette[\"line\"][0], palette[\"line\"][1], palette[\"line\"][2]))\n        circle.line.width = Pt(0.5)\n\ndef generate_background(slide, theme_name, draw_decoration=True):\n    palette = THEMES[theme_name]\n    # overall background\n    bg = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, Inches(0), Inches(0), Inches(13.333), Inches(7.5))\n    bg.fill.solid()\n    bg.fill.fore_color.rgb = rgb(palette[\"bg\"])\n    bg.line.color.rgb = rgb(palette[\"bg\"])\n    if draw_decoration:\n        add_background_pattern(slide, theme_name)\n        # A zone\n        add_cloud(slide, Inches(0.3), Inches(0.3), Inches(1.4), Inches(0.7), rgb(palette[\"bg2\"]), rgb(palette[\"line\"]))\n        add_cloud(slide, Inches(11.0), Inches(0.4), Inches(1.6), Inches(0.7), rgb(palette[\"bg2\"]), rgb(palette[\"line\"]))\n        # B zone\n        add_corner_floral(slide, theme_name, Inches(0.6), Inches(6.6), size=1.3)\n        add_corner_floral(slide, theme_name, Inches(12.2), Inches(6.6), size=1.3)\n        # C baseline\n        add_baseline(slide, theme_name, 0.88)\n        # E very center soft shapes\n        for i in range(3):\n            add_circle(slide, Inches(3 + i*3.2), Inches(3.0), 0.55, palette[\"bg2\"], palette[\"line\"])\n    return bg\n\ndef add_zone_decor(slide, theme_name, zone, style=\"generic\"):\n    palette = THEMES[theme_name]\n    if zone == \"A1\":\n        add_cloud(slide, Inches(0.2), Inches(0.20), Inches(1.4), Inches(0.8), rgb(palette[\"bg2\"]), rgb(palette[\"line\"]))\n        add_leaf(slide, Inches(0.1), Inches(0.65), Inches(0.6), Inches(0.9), rgb(palette[\"accent2\"]), rgb(palette[\"line\"]))\n    elif zone == \"A2\":\n        add_cloud(slide, Inches(11.5), Inches(0.20), Inches(1.3), Inches(0.8), rgb(palette[\"bg2\"]), rgb(palette[\"line\"]))\n        add_leaf(slide, Inches(12.1), Inches(0.65), Inches(0.6), Inches(0.9), rgb(palette[\"accent2\"]), rgb(palette[\"line\"]))\n    elif zone == \"B1\":\n        add_leaf(slide, Inches(0.3), Inches(6.0), Inches(1.3), Inches(1.2), rgb(palette[\"accent2\"]), rgb(palette[\"line\"]))\n    elif zone == \"B2\":\n        add_leaf(slide, Inches(11.7), Inches(6.0), Inches(1.3), Inches(1.2), rgb(palette[\"accent2\"]), rgb(palette[\"line\"]))\n    elif zone == \"C\":\n        add_baseline(slide, theme_name, 0.88)\n    elif zone == \"D\":\n        # decorative ribbon / band\n        band = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, Inches(1.1), Inches(1.0), Inches(10.9), Inches(0.15))\n        band.fill.solid()\n        band.fill.fore_color.rgb = rgb(palette[\"accent2\"])\n        band.line.color.rgb = rgb(palette[\"line\"])\n        band.line.width = Pt(0.8)\n    elif zone == \"E\":\n        # background pattern\n        add_background_pattern(slide, theme_name)\n\ndef add_title_block(slide, theme_name, title, subtitle=\"\"):\n    palette = THEMES[theme_name]\n    title_box = slide.shapes.add_textbox(Inches(0.8), Inches(0.7), Inches(7.5), Inches(0.7))\n    tf = title_box.text_frame\n    tf.word_wrap = True\n    p = tf.paragraphs[0]\n    p.text = title\n    p.alignment = 1\n    run = p.runs[0]\n    run.font.name = \"Arial\"\n    run.font.size = Pt(26)\n    run.font.bold = True\n    run.font.color.rgb = rgb(palette[\"title\"])\n\n    if subtitle:\n        sub_box = slide.shapes.add_textbox(Inches(0.8), Inches(1.35), Inches(7.0), Inches(0.4))\n        tf2 = sub_box.text_frame\n        p2 = tf2.paragraphs[0]\n        p2.text = subtitle\n        r2 = p2.runs[0]\n        r2.font.name = \"Arial\"\n        r2.font.size = Pt(11)\n        r2.font.color.rgb = rgb(palette[\"text\"])\n\ndef demo():\n    prs = Presentation()\n    prs.slide_width = Inches(13.333)\n    prs.slide_height = Inches(7.5)\n    slide = prs.slides.add_slide(prs.slide_layouts[6])\n    generate_background(slide, \"travel\")\n    add_zone_decor(slide, \"travel\", \"A1\")\n    add_zone_decor(slide, \"travel\", \"A2\")\n    add_zone_decor(slide, \"travel\", \"B1\")\n    add_zone_decor(slide, \"travel\", \"B2\")\n    add_zone_decor(slide, \"travel\", \"C\")\n    add_title_block(slide, \"travel\", \"Demo Decor\")\n    prs.save(\"decor_demo.pptx\")\n    print(\"Saved: decor_demo.pptx\")\n\nif __name__ == \"__main__\":\n    demo()\n```\n\n2) theme_selector.py\n```python\n#!/usr/bin/env python3\n\"\"\"\ntheme_selector.py\n- nhập raw text hoặc file .txt / .docx / .pdf\n- đánh giá chủ đề và theme phù hợp\n- trả về:\n  {\n    \"theme\": ...,\n    \"confidence\": ...,\n    \"design_spec\": {...},\n    \"keywords\": [...]\n  }\n- xuất JSON ra terminal hoặc file nếu --output\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport re\nfrom pathlib import Path\nfrom typing import Dict, List, Optional\n\n# ---------------------------------------------------------------------\n# Theme rules\n# ---------------------------------------------------------------------\nTOPIC_RULES = {\n    \"heritage_report\": {\n        \"keywords\": [\n            \"lich su\", \"history\", \"truyen thong\", \"van hoa\", \"di tich\", \"danh lam\", \"thoi tran\", \"viet nam\", \"dân tộc\",\n            \"le hoi\", \"cach mang\", \"huyền thoại\", \"di san\", \"luu dan\"\n        ],\n        \"label\": \"Lịch sử / heritage\",\n        \"palette\": [\"#800020\", \"#5d2c1d\", \"#F5F2EB\", \"#D9B077\", \"#2E3033\"],\n        \"fonts\": [\"Playfair Display\", \"Lora\", \"Be Vietnam Pro\"],\n        \"layout\": \"cover + intro + two-column + summary + quote\",\n        \"decor\": [\"lotus\", \"cloud\", \"paper texture\", \"frame ornament\", \"ancient architecture\", \"trúc\", \"mây\"],\n        \"mood\": \"trang trọng, cổ điển, học thuật\"\n    },\n    \"travel\": {\n        \"keywords\": [\"du lich\", \"travel\", \"tour\", \"trip\", \"diem den\", \"tourism\", \"vietnam travel\", \"di du lich\", \"diem tham quan\", \"itinerary\"],\n        \"label\": \"Du lịch / travel\",\n        \"palette\": [\"#E8F0EC\", \"#7C9A6C\", \"#F3ECCF\", \"#D9C08D\", \"#2D5A27\"],\n        \"fonts\": [\"Playfair Display\", \"Be Vietnam Pro\", \"Merriweather\"],\n        \"layout\": \"cover + destination cards + activities + itinerary + conclusion\",\n        \"decor\": [\"mountain\", \"lake\", \"cloud\", \"leaf\", \"boat\", \"flower\", \"watercolor\"],\n        \"mood\": \"tươi, thơ mộng, trải nghiệm\"\n    },\n    \"literature\": {\n        \"keywords\": [\"van hoc\", \"literature\", \"tho\", \"poetry\", \"truyen ngan\", \"ngon ngu\", \"tu tuong\", \"sach\", \"doc gia\", \"van chuong\", \"nhan vat\"],\n        \"label\": \"Văn học / literature\",\n        \"palette\": [\"#E9EFE7\", \"#A7CFB7\", \"#F3D9DC\", \"#6B4E41\", \"#11261E\"],\n        \"fonts\": [\"Playfair Display\", \"Cormorant Garamond\", \"Be Vietnam Pro\"],\n        \"layout\": \"cover + quote + concept + theme + conclusion\",\n        \"decor\": [\"lotus\", \"ink stroke\", \"paper texture\", \"calligraphy\", \"frame\"],\n        \"mood\": \"nghệ thuật, lãng mạn, sâu sắc\"\n    },\n    \"game\": {\n        \"keywords\": [\"game\", \"tro choi\", \"quiz game\", \"quiz\", \"adventure\", \"treasure\", \"puzzle\", \"interactive\", \"challenge\", \"reward\", \"do vui\", \"truy tim\", \"quest\"],\n        \"label\": \"Game / quiz / interactive\",\n        \"palette\": [\"#4AB5F6\", \"#FFD166\", \"#1D3557\", \"#EAF7FF\", \"#2A8C63\"],\n        \"fonts\": [\"Verdana\", \"Baloo 2\", \"Nunito\", \"Arial\"],\n        \"layout\": \"cover + question + answer grid + result + summary\",\n        \"decor\": [\"treasure chest\", \"question box\", \"button\", \"icon set\", \"pixel map\", \"grass\"],\n        \"mood\": \"tương tác, vui, sinh động\"\n    },\n    \"education\": {\n        \"keywords\": [\"giao duc\", \"education\", \"hoc tap\", \"bai giang\", \"giang day\", \"project\", \"hoc sinh\", \"lop hoc\", \"classroom\", \"report\", \"khoa hoc\"],\n        \"label\": \"Giáo dục / project / classroom\",\n        \"palette\": [\"#F7EBAA\", \"#5E9D52\", \"#FFF9E9\", \"#F7C66B\", \"#2F3B2F\"],\n        \"fonts\": [\"Lexend\", \"Baloo 2\", \"Be Vietnam Pro\"],\n        \"layout\": \"cover + objective + section + practice + summary\",\n        \"decor\": [\"greenboard\", \"sticker\", \"sun\", \"leaf\", \"mascot\", \"task card\"],\n        \"mood\": \"giảng dạy, rõ ràng, thân thiện\"\n    },\n    \"preschool\": {\n        \"keywords\": [\"mam non\", \"preschool\", \"kids\", \"tre em\", \"young learners\", \"primary school\", \"animal\", \"be be\", \"little\", \"school\", \"hoat dong\"],\n        \"label\": \"Mầm non / preschool\",\n        \"palette\": [\"#D9F0C4\", \"#F2D6B3\", \"#F6F7F1\", \"#7DBF6D\", \"#EDC7B7\"],\n        \"fonts\": [\"Nunito\", \"Baloo 2\", \"Comic Sans MS\"],\n        \"layout\": \"cover + activity + question + practice + thank you\",\n        \"decor\": [\"mascot\", \"cloud\", \"star\", \"cute icon\", \"playground\", \"butterfly\"],\n        \"mood\": \"dễ thương, vui, ấm áp\"\n    },\n    \"environment\": {\n        \"keywords\": [\"moi truong\", \"environment\", \"forest\", \"restoration\", \"green\", \"eco\", \"sinh thai\", \"climate\", \"trong cay\", \"rung\", \"cay xanh\"],\n        \"label\": \"Môi trường / eco\",\n        \"palette\": [\"#E8F0EC\", \"#2D5A27\", \"#E2A03F\", \"#F2F6F1\", \"#B9D4AD\"],\n        \"fonts\": [\"Lora\", \"Nunito\", \"Be Vietnam Pro\"],\n        \"layout\": \"cover + issue + causes + benefits + action + conclusion\",\n        \"decor\": [\"forest\", \"leaf\", \"earth\", \"waterdrop\", \"sustainable\", \"tree\"],\n        \"mood\": \"bền vững, tự nhiên, mát mắt\"\n    }\n}\n\n# ---------------------------------------------------------------------\n# Utility functions\n# ---------------------------------------------------------------------\ndef normalize_text(raw: str) -> str:\n    if raw is None:\n        return \"\"\n    s = raw.lower()\n    s = s.replace(\"đ\", \"d\")\n    s = s.replace(\"Đ\", \"D\")\n    s = s.replace(\"\\\\n\", \" \")\n    s = re.sub(r\"\\\\s+\", \" \", s)\n    return s.strip()\n\ndef clean_text(raw: str) -> str:\n    s = raw.replace(\"\\\\x00\", \"\")\n    s = re.sub(r\"\\\\s+\", \" \", s)\n    return s.strip()\n\ndef extract_keywords(text: str, top_n: int = 20) -> List[str]:\n    words = re.findall(r\"[a-zA-Z0-9à-ỹÀ-Ỹ]+\", text.lower())\n    stop = {\n        \"va\", \"la\", \"mot\", \"cua\", \"cho\", \"voi\", \"co\", \"de\", \"day\", \"trong\", \"vao\", \"khong\", \"thi\", \"nhung\",\n        \"ma\", \"tu\", \"theo\", \"cung\", \"nhu\", \"nay\", \"cac\", \"do\", \"và\", \"là\", \"một\", \"các\", \"đây\", \"sao\"\n    }\n    freq = {}\n    for w in words:\n        if len(w) <= 2:\n            continue\n        if w in stop:\n            continue\n        freq[w] = freq.get(w, 0) + 1\n    return [w for w, _ in sorted(freq.items(), key=lambda kv: (-kv[1], kv[0]))[:top_n]]\n\ndef score_document(text: str) -> Dict[str, float]:\n    norm = normalize_text(text)\n    scores = {}\n    for theme, cfg in TOPIC_RULES.items():\n        score = 0.0\n        for kw in cfg[\\\"keywords\\\"]:\n            if normalize_text(kw) in norm:\n                score += 2.0\n        keywords = extract_keywords(text, top_n=20)\n        for kw in keywords:\n            for k in cfg[\\\"keywords\\\"]:\n                if kw in normalize_text(k):\n                    score += 0.5\n        scores[theme] = round(score, 2)\n    return scores\n\ndef choose_theme(text: str) -> Dict:\n    scores = score_document(text)\n    if not scores:\n        raise ValueError(\"Không thể phân tích nội dung.\")\n    best_theme = max(scores, key=scores.get)\n    confidence = 0.0\n    total = sum(scores.values())\n    if total > 0:\n        best_val = scores[best_theme]\n        confidence = round(min(0.99, best_val / max(1.0, total * 0.7)), 2)\n    cfg = TOPIC_RULES[best_theme]\n    return {\n        \"theme\": best_theme,\n        \"label\": cfg[\\\"label\\\"],\n        \"confidence\": confidence,\n        \"scores\": scores,\n        \"palette\": cfg[\\\"palette\\\"],\n        \"fonts\": cfg[\\\"fonts\\\"],\n        \\\"layout\\\": cfg[\\\"layout\\\"],\n        \\\"decor\\\": cfg[\\\"decor\\\"],\n        \\\"mood\\\": cfg[\\\"mood\\\"],\n        \\\"keywords\\\": extract_keywords(text, top_n=15)\n    }\n\ndef read_txt(path: str) -> str:\n    with open(path, \\\"r\\\", encoding=\\\"utf-8\\\", errors=\\\"ignore\\\") as f:\n        return f.read()\n\ndef read_docx(path: str) -> str:\n    try:\n        from docx import Document\n    except Exception as e:\n        raise RuntimeError(f\"python-docx chưa cài: {e}\")\n    doc = Document(path)\n    paras = []\n    for p in doc.paragraphs:\n        t = p.text.strip()\n        if t:\n            paras.append(t)\n    return \\\"\\\\n\\\".join(paras)\n\ndef read_pdf(path: str) -> str:\n    try:\n        from pypdf import PdfReader\n    except Exception as e:\n        raise RuntimeError(f\"pypdf chưa cài: {e}\")\n    reader = PdfReader(path)\n    pages = []\n    for page in reader.pages:\n        text = page.extract_text() or \\\"\\\"\n        if text.strip():\n            pages.append(text.strip())\n    return \\\"\\\\n\\\".join(pages)\n\ndef read_input_data(path_or_text: str) -> str:\n    if os.path.exists(path_or_text):\n        suffix = Path(path_or_text).suffix.lower()\n        if suffix == \\\".txt\\\" or suffix == \\\".md\\\":\n            return read_txt(path_or_text)\n        if suffix == \\\".docx\\\":\n            return read_docx(path_or_text)\n        if suffix == \\\".pdf\\\":\n            return read_pdf(path_or_text)\n        return read_txt(path_or_text)\n    return path_or_text\n\ndef build_design_spec(doc_text: str, theme_override: Optional[str] = None) -> Dict:\n    text = clean_text(doc_text)\n    if not text:\n        raise ValueError(\\\"Tài liệu đầu vào rỗng.\\\")\n    result = choose_theme(text)\n    theme = theme_override if theme_override in TOPIC_RULES else result[\\\"theme\\\"]\n    cfg = TOPIC_RULES[theme]\n    score_map = score_document(text)\n    scores_sorted = dict(sorted(score_map.items(), key=lambda kv: kv[1], reverse=True))\n    confidence = round((score_map.get(theme, 0) / max(1, sum(score_map.values()))) * 1.8, 2)\n    if confidence > 1.0:\n        confidence = 1.0\n\n    spec = {\n        \\\"theme\\\": theme,\n        \\\"theme_label\\\": cfg[\\\"label\\\"],\n        \\\"confidence\\\": confidence,\n        \\\"palette\\\": cfg[\\\"palette\\\"],\n        \\\"fonts\\\": cfg[\\\"fonts\\\"],\n        \\\"layout\\\": cfg[\\\"layout\\\"],\n        \\\"mood\\\": cfg[\\\"mood\\\"],\n        \\\"decor\\\": cfg[\\\"decor\\\"],\n        \\\"recommended_slide_count\\\": 8 if theme not in {\\\"game\\\", \\\"preschool\\\"} else 10,\n        \\\"scores\\\": scores_sorted,\n        \\\"keywords\\\": extract_keywords(text, top_n=15),\n        \\\"document_summary\\\": {\n            \\\"word_count\\\": len(text.split()),\n            \\\"audience\\\": \"preschool\" if any(t in normalize_text(text) for t in [\"mam non\", \"tre em\", \"kids\", \"preschool\"]) else \"general\"\n        },\n        \\\"layout_spec\\\": {\n            \"cover\": \"title + hero image / large text\",\n            \"objective\": \"3-5 bullets / key message\",\n            \"content\": \"2-col / cards / diagram\",\n            \"summary\": \"takeaways / conclusion\",\n            \"activity\": \"quiz / group task / hands-on\" if theme in {\\\"game\\\", \\\"education\\\", \\\"preschool\\\"} else \"summary blocks\"\n        },\n        \\\"decor_placement\\\": {\n            \"A\": \"góc trên: cloud, branch, ribbon, hoa/leaf\",\n            \"B\": \"góc dưới: mascot, button, rương, chậu cây\",\n            \"C\": \"dải dưới: thảm cỏ, biển, nền so le\",\n            \"D\": \"khung card: washi tape, dây, chấm, hoa\",\n            \"E\": \"nền: line art, mây mờ, giấy xước\"\n        }\n    }\n    return spec\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Theme selector + design spec generator\")\n    parser.add_argument(\"input\", nargs=\"?\", help=\"raw text or file path (.txt, .docx, .pdf)\")\n    parser.add_argument(\"--text\", help=\"text trực tiếp\")\n    parser.add_argument(\"--output\", help=\"file JSON output path\")\n    parser.add_argument(\"--theme\", help=\"override theme nếu muốn\")\n    args = parser.parse_args()\n\n    if args.text:\n        content = args.text\n    elif args.input:\n        content = read_input_data(args.input)\n    else:\n        content = input(\"Nhập văn bản hoặc đường dẫn file: \").strip()\n\n    spec = build_design_spec(content, theme_override=args.theme)\n    out = json.dumps(spec, ensure_ascii=False, indent=2)\n    print(out)\n\n    if args.output:\n        p = Path(args.output)\n        p.parent.mkdir(parents=True, exist_ok=True)\n        p.write_text(out, encoding=\"utf-8\")\n        print(f\"\\\\nSaved JSON spec to: {p}\")\n\nif __name__ == \"__main__\":\n    try:\n        main()\n    except Exception as e:\n        import traceback\n        traceback.print_exc()\n        print(f\"ERROR: {e}\")\n```\n\n3) auto_layout_generator.py\n```python\n#!/usr/bin/env python3\n\"\"\"\nauto_layout_generator.py\n- nhận design spec JSON từ theme_selector.py\n- tạo slide 6–12 theo theme\n- render bằng python-pptx\n- dùng decor_generator.py để tạo nền/shape decor, nếu thiếu ảnh thật\n\nCách dùng:\n  python auto_layout_generator.py --spec design_spec.json --out output.pptx\n  hoặc\n  python auto_layout_generator.py --text \"Bài giảng ...\"\n\nYêu cầu:\n  pip install python-pptx\n\"\"\"\n\nimport argparse\nimport json\nimport os\nfrom pathlib import Path\nfrom typing import Dict, Any\n\nfrom pptx import Presentation\nfrom pptx.util import Inches, Pt\nfrom pptx.dml.color import RGBColor\nfrom pptx.enum.text import PP_ALIGN\nfrom pptx.enum.shapes import MSO_SHAPE\n\nfrom decor_generator import THEMES, generate_background, add_zone_decor, add_title_block\n\n# ---------------------------------------------\n# helper functions\n# ---------------------------------------------\ndef rgb(t):\n    return RGBColor(t[0], t[1], t[2])\n\ndef make_slide(prs):\n    return prs.slides.add_slide(prs.slide_layouts[6])\n\ndef add_textbox(slide, left, top, width, height, text, font_name=\"Arial\", size=20, color=(0,0,0), bold=False, align=\"left\"):\n    box = slide.shapes.add_textbox(left, top, width, height)\n    tf = box.text_frame\n    tf.word_wrap = True\n    tf.margin_left = 6\n    tf.margin_right = 6\n    tf.margin_top = 2\n    tf.margin_bottom = 2\n    p = tf.paragraphs[0]\n    p.text = text\n    p.alignment = PP_ALIGN.LEFT if align == \"left\" else (PP_ALIGN.CENTER if align == \"center\" else PP_ALIGN.RIGHT)\n    r = p.runs[0]\n    r.font.name = font_name\n    r.font.size = Pt(size)\n    r.font.bold = bold\n    r.font.color.rgb = rgb(color)\n    return box\n\ndef add_panel(slide, left, top, w, h, fill, line, radius=16):\n    shp = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, left, top, w, h)\n    shp.fill.solid()\n    shp.fill.fore_color.rgb = rgb(fill)\n    shp.line.color.rgb = rgb(line)\n    shp.line.width = Pt(1.2)\n    return shp\n\ndef add_bullets(slide, left, top, w, h, items, font, size=15, color=(0,0,0), bullet=True):\n    box = slide.shapes.add_textbox(left, top, w, h)\n    tf = box.text_frame\n    tf.clear()\n    tf.word_wrap = True\n    for i, item in enumerate(items):\n        p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()\n        p.text = item\n        p.level = 0\n        p.bullet = bullet\n        p.space_after = 5\n        r = p.runs[0]\n        r.font.name = font\n        r.font.size = Pt(size)\n        r.font.color.rgb = rgb(color)\n    return box\n\n# ---------------------------------------------\n# load spec\n# ---------------------------------------------\ndef load_spec(spec_json: str):\n    if os.path.exists(spec_json):\n        with open(spec_json, \"r\", encoding=\"utf-8\") as f:\n            return json.load(f)\n    # treat as raw JSON string\n    return json.loads(spec_json)\n\n# ---------------------------------------------\n# slide builders\n# ---------------------------------------------\ndef build_cover_slide(prs, theme_name, title, subtitle):\n    slide = make_slide(prs)\n    palette = THEMES[theme_name]\n    generate_background(slide, theme_name)\n    add_zone_decor(slide, theme_name, \"A1\")\n    add_zone_decor(slide, theme_name, \"A2\")\n    add_zone_decor(slide, theme_name, \"C\")\n    panel = add_panel(slide, Inches(0.9), Inches(1.0), Inches(11.4), Inches(5.0), palette[\"panel\"], palette[\"line\"], 20)\n    add_textbox(slide, Inches(1.3), Inches(1.8), Inches(8.0), Inches(1.3), title, \"Playfair Display\", 30, palette[\"title\"], True, \"left\")\n    add_textbox(slide, Inches(1.35), Inches(3.1), Inches(6.5), Inches(0.8), subtitle, \"Be Vietnam Pro\", 14, palette[\"text\"], False, \"left\")\n    # image placeholder\n    img = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, Inches(8.8), Inches(1.8), Inches(2.6), Inches(2.8))\n    img.fill.solid()\n    img.fill.fore_color.rgb = rgb(palette[\"bg2\"])\n    img.line.color.rgb = rgb(palette[\"line\"])\n    return slide\n\ndef build_objective_slide(prs, theme_name, title, bullets):\n    slide = make_slide(prs)\n    palette = THEMES[theme_name]\n    generate_background(slide, theme_name)\n    add_zone_decor(slide, theme_name, \"D\")\n    add_zone_decor(slide, theme_name, \"A1\")\n    add_zone_decor(slide, theme_name, \"A2\")\n    panel = add_panel(slide, Inches(0.9), Inches(1.0), Inches(11.4), Inches(5.2), palette[\"panel\"], palette[\"line\"], 16)\n    add_textbox(slide, Inches(1.2), Inches(1.3), Inches(7.0), Inches(0.8), title, \"Playfair Display\", 26, palette[\"title\"], True, \"left\")\n    add_bullets(slide, Inches(1.4), Inches(2.2), Inches(9.0), Inches(2.8), bullets, \"Be Vietnam Pro\", 16, palette[\"text\"])\n    return slide\n\ndef build_content_slide(prs, theme_name, title, left_items, right_items=None):\n    slide = make_slide(prs)\n    palette = THEMES[theme_name]\n    generate_background(slide, theme_name)\n    add_zone_decor(slide, theme_name, \"A1\")\n    add_zone_decor(slide, theme_name, \"A2\")\n    add_zone_decor(slide, theme_name, \"D\")\n    left = add_panel(slide, Inches(0.9), Inches(1.2), Inches(5.5), Inches(4.8), palette[\"panel\"], palette[\"line\"], 18)\n    right = add_panel(slide, Inches(6.8), Inches(1.2), Inches(5.5), Inches(4.8), palette[\"panel\"], palette[\"line\"], 18)\n    add_textbox(slide, Inches(1.2), Inches(1.5), Inches(4.5), Inches(0.8), title, \"Playfair Display\", 22, palette[\"title\"], True, \"left\")\n    add_bullets(slide, Inches(1.3), Inches(2.3), Inches(4.3), Inches(2.5), left_items, \"Be Vietnam Pro\", 15, palette[\"text\"])\n    if right_items:\n        add_textbox(slide, Inches(7.2), Inches(1.5), Inches(4.2), Inches(0.7), \"Key takeaway\", \"Be Vietnam Pro\", 12, palette[\"title\"], True, \"left\")\n        add_bullets(slide, Inches(7.2), Inches(2.3), Inches(4.2), Inches(2.4), right_items, \"Be Vietnam Pro\", 14, palette[\"text\"])\n    return slide\n\ndef build_compare_slide(prs, theme_name, title, rows):\n    slide = make_slide(prs)\n    palette = THEMES[theme_name]\n    generate_background(slide, theme_name)\n    add_zone_decor(slide, theme_name, \"A1\")\n    add_zone_decor(slide, theme_name, \"A2\")\n    add_zone_decor(slide, theme_name, \"D\")\n    panel = add_panel(slide, Inches(0.9), Inches(1.1), Inches(11.4), Inches(5.2), palette[\"panel\"], palette[\"line\"], 18)\n    add_textbox(slide, Inches(1.3), Inches(1.4), Inches(8.0), Inches(0.7), title, \"Playfair Display\", 24, palette[\"title\"], True, \"left\")\n    y = 2.1\n    for idx, row in enumerate(rows):\n        # left and right columns\n        seg = add_panel(slide, Inches(1.3), Inches(y), Inches(4.6), Inches(0.65), palette[\"bg2\"], palette[\"line\"], 10)\n        seg2 = add_panel(slide, Inches(6.6), Inches(y), Inches(4.8), Inches(0.65), palette[\"bg2\"], palette[\"line\"], 10)\n        add_textbox(slide, Inches(1.5), Inches(y+0.12), Inches(4.0), Inches(0.35), row[0], \"Be Vietnam Pro\", 13, palette[\"text\"], False, \"left\")\n        add_textbox(slide, Inches(6.9), Inches(y+0.12), Inches(4.2), Inches(0.35), row[1], \"Be Vietnam Pro\", 13, palette[\"text\"], False, \"left\")\n        y += 0.7\n    return slide\n\ndef build_summary_slide(prs, theme_name, title, bullets):\n    slide = make_slide(prs)\n    palette = THEMES[theme_name]\n    generate_background(slide, theme_name)\n    add_zone_decor(slide, theme_name, \"A1\")\n    add_zone_decor(slide, theme_name, \"A2\")\n    add_zone_decor(slide, theme_name, \"C\")\n    panel = add_panel(slide, Inches(1.0), Inches(1.1), Inches(11.2), Inches(5.3), palette[\"panel\"], palette[\"line\"], 18)\n    add_textbox(slide, Inches(1.4), Inches(1.5), Inches(5.5), Inches(0.8), title, \"Playfair Display\", 24, palette[\"title\"], True, \"left\")\n    add_bullets(slide, Inches(1.5), Inches(2.5), Inches(8.8), Inches(2.8), bullets, \"Be Vietnam Pro\", 15, palette[\"text\"])\n    return slide\n\n# ---------------------------------------------\n# Build 6-12 slides based on theme\n# ---------------------------------------------\ndef build_presentation(spec: Dict):\n    prs = Presentation()\n    prs.slide_width = Inches(13.333)\n    prs.slide_height = Inches(7.5)\n    theme = spec.get(\"theme\", \"education\")\n    title = spec.get(\"theme_label\", \"Bài giảng\")\n    palette = THEMES.get(theme, THEMES[\"education\"])\n\n    # Theme calculation and generic body\n    keywords = spec.get(\"keywords\", [\"Bài giảng\", \"Tổng kết\"])\n    slide_count = int(spec.get(\"recommended_slide_count\", 8))\n    # clip to 6-12\n    if slide_count < 6:\n        slide_count = 6\n    if slide_count > 12:\n        slide_count = 12\n\n    # Prepare generic content based on theme\n    if theme == \"heritage_report\":\n        sections = [\n            (\"cover\", \"Lịch sử Việt Nam\", \"Di sản văn hóa và truyền thống\"),\n            (\"objective\", \"Mục tiêu bài học\", [\"Nhận biết bối cảnh lịch sử\", \"Hiểu giá trị văn hóa\", \"Tổng kết di sản\"]),\n            (\"content\", \"Bối cảnh lịch sử\", [\"Thời kỳ hình thành\", \"Những thành tựu nổi bật\", \"Tầm ảnh hưởng\"], [\"Di tích\", \"Nét văn hóa\", \"Tính liên tục\"]),\n            (\"compare\", \"So sánh giai đoạn\", [(\"Thời kỳ\", \"Đặc điểm\"), (\"Trước\", \"Cơ sở hình thành\"), (\"Sau\", \"Phát triển sâu rộng\")]),\n            (\"summary\", \"Kết luận\", [\"Lịch sử là căn cứ cho nhận thức\", \"Giá trị văn hóa cần được gìn giữ\", \"Bền vững qua thời gian\"])\n        ]\n    elif theme == \"travel\":\n        sections = [\n            (\"cover\", \"Du lịch Việt Nam\", \"Khám phá vẻ đẹp quê hương\"),\n            (\"objective\", \"Mục tiêu\", [\"Điểm đến nổi tiếng\", \"Hành trình trải nghiệm\", \"Khuyến nghị cho du khách\"]),\n            (\"content\", \"Điểm đến hấp dẫn\", [\"Địa danh nổi tiếng\", \"Ẩm thực đặc sản\", \"Gợi ý lộ trình\"], [\"Chuyến đi\", \"Trải nghiệm\", \"Kỷ niệm\"]),\n            (\"compare\", \"So sánh trải nghiệm\", [(\"Thiên nhiên\", \"Văn hóa\"), (\"Môi trường\", \"Thực tế du lịch\"), (\"Khảo thám\", \"Cảm giác\")]),\n            (\"summary\", \"Kết luận\", [\"Du lịch tạo nên trải nghiệm\", \"Cần bảo tồn và phát triển\", \"Khuyến khích khám phá\"])\n        ]\n    elif theme == \"literature\":\n        sections = [\n            (\"cover\", \"Văn học\", \"Nét đẹp của ngôn ngữ & cảm xúc\"),\n            (\"objective\", \"Mục tiêu\", [\"Hiểu giá trị văn học\", \"Lựa chọn từ ngữ phong phú\", \"Tạo cảm xúc\"]),\n            (\"content\", \"Các khái niệm\", [\"Thơ ca\", \"Nội dung\", \"Nhân vật\"], [\"Tác phẩm\", \"Cảm nhận\", \"Nhịp điệu\"]),\n            (\"compare\", \"So sánh phong cách\", [(\"Thơ\", \"Nhấn vào cảm xúc\"), (\"Truyện\", \"Nội dung và nhân vật\"), (\"Bài viết\", \"Thuyết minh\")]),\n            (\"summary\", \"Kết luận\", [\"Ngôn ngữ là phương tiện giao tiếp\", \"Văn học gắn với con người\", \"Giá trị lâu dài\"])\n        ]\n    elif theme == \"game\":\n        sections = [\n            (\"cover\", \"Trò chơi\", \"Quiz game & challenge\"),\n            (\"objective\", \"Mục tiêu\", [\"Kích thích tư duy\", \"Luyện tập kiến thức\", \"Học qua trò chơi\"]),\n            (\"content\", \"Cấu trúc quiz\", [\"Câu hỏi\", \"Đáp án\", \"Đánh giá\"], [\"Rèn kỹ năng\", \"Hiệu ứng\", \"Feedback