        "language": "python",
        "name": "extended_design_system.py",
        "value": "from pptx import Presentation\nfrom pptx.util import Inches, Pt\nfrom pptx.dml.color import RGBColor\nfrom pptx.enum.shapes import MSO_SHAPE\nfrom pptx.enum.text import PP_ALIGN\n\n# -------------------------------------------------\n# 1) Theme palettes\n# -------------------------------------------------\nTHEMES = {\n    \"pastel\": {\n        \"bg\": (247, 242, 232),       # cream\n        \"bg2\": (255, 233, 236),      # pink pastel\n        \"panel\": (255, 255, 255),\n        \"accent\": (250, 122, 127),   # coral pink\n        \"accent2\": (255, 210, 120),  # yellow pastel\n        \"text\": (39, 39, 39),\n        \"title\": (86, 51, 67),\n        \"line\": (245, 187, 194),\n        \"zoneA\": (255, 244, 248),\n        \"zoneB\": (236, 246, 230),\n        \"zoneC\": (255, 236, 197),\n    },\n    \"eco\": {\n        \"bg\": (233, 239, 233),       # soft green\n        \"bg2\": (215, 227, 210),\n        \"panel\": (248, 251, 246),\n        \"accent\": (48, 90, 39),      # forest green\n        \"accent2\": (134, 173, 120),  # light green\n        \"text\": (22, 38, 28),\n        \"title\": (38, 74, 39),\n        \"line\": (146, 177, 120),\n        \"zoneA\": (232, 244, 230),\n        \"zoneB\": (219, 235, 213),\n        \"zoneC\": (200, 220, 182),\n    },\n    \"group\": {\n        \"bg\": (214, 239, 255),       # pastel blue\n        \"bg2\": (240, 250, 255),\n        \"panel\": (255, 255, 255),\n        \"accent\": (255, 186, 60),    # golden yellow\n        \"accent2\": (93, 173, 255),   # blue\n        \"text\": (35, 41, 50),\n        \"title\": (52, 117, 176),\n        \"line\": (143, 204, 255),\n        \"zoneA\": (247, 251, 255),\n        \"zoneB\": (255, 247, 222),\n        \"zoneC\": (201, 236, 255),\n    },\n    \"chinese\": {\n        \"bg\": (245, 238, 228),       # warm paper\n        \"bg2\": (184, 60, 47),        # red\n        \"panel\": (255, 249, 245),\n        \"accent\": (154, 39, 25),     # deep red\n        \"accent2\": (219, 166, 72),   # gold\n        \"text\": (51, 29, 20),\n        \"title\": (128, 38, 29),\n        \"line\": (219, 166, 72),\n        \"zoneA\": (255, 245, 236),\n        \"zoneB\": (248, 232, 214),\n        \"zoneC\": (238, 199, 152),\n    }\n}\n\n# -------------------------------------------------\n# 2) Helper functions\n# -------------------------------------------------\ndef rgb(triple):\n    return RGBColor(triple[0], triple[1], triple[2])\n\ndef set_bg(slide, color):\n    fill = slide.background.fill\n    fill.solid()\n    fill.fore_color.rgb = rgb(color)\n\ndef add_textbox(slide, left, top, width, height, text, font, size=26, color=(0,0,0), bold=False, align=\"left\"):\n    box = slide.shapes.add_textbox(left, top, width, height)\n    tf = box.text_frame\n    tf.word_wrap = True\n    tf.margin_left = 6\n    tf.margin_right = 6\n    tf.margin_top = 4\n    tf.margin_bottom = 4\n    p = tf.paragraphs[0]\n    p.text = text\n    r = p.runs[0]\n    r.font.name = font\n    r.font.size = Pt(size)\n    r.font.bold = bold\n    r.font.color.rgb = rgb(color)\n    if align == \"center\":\n        p.alignment = PP_ALIGN.CENTER\n    elif align == \"right\":\n        p.alignment = PP_ALIGN.RIGHT\n    return box\n\ndef add_bullets(slide, left, top, width, height, items, font, size=16, color=(0,0,0), bullet_color=(0,0,0)):\n    box = slide.shapes.add_textbox(left, top, width, height)\n    tf = box.text_frame\n    tf.word_wrap = True\n    tf.clear()\n    for i, item in enumerate(items):\n        p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()\n        p.text = item\n        p.level = 0\n        p.bullet = True\n        p.space_after = 4\n        p.text = item\n        run = p.runs[0]\n        run.font.name = font\n        run.font.size = Pt(size)\n        run.font.color.rgb = rgb(color)\n        run.font.bold = False\n    return box\n\ndef add_panel(slide, left, top, width, height, fill_color, line_color=None, radius=18):\n    # draw rounded rectangle\n    shape = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, left, top, width, height)\n    shape.fill.solid()\n    shape.fill.fore_color.rgb = rgb(fill_color)\n    if line_color is None:\n        line_color = fill_color\n    shape.line.color.rgb = rgb(line_color)\n    shape.line.width = Pt(1.5)\n    return shape\n\ndef add_zone_decor(slide, theme, zone, kind):\n    # zone: A1, A2, B1, B2, C, D, E\n    # kind: simple decorative patterns for demo\n    colors = THEMES[theme]\n    if zone == \"A1\":\n        # simple corner leaf / cloud\n        shape = slide.shapes.add_shape(MSO_SHAPE.OVAL, Inches(0.35), Inches(0.4), Inches(1.2), Inches(0.8))\n        shape.fill.solid()\n        shape.fill.fore_color.rgb = rgb(colors[\"accent2\"])\n        shape.line.color.rgb = rgb(colors[\"line\"])\n        return shape\n    if zone == \"A2\":\n        shape = slide.shapes.add_shape(MSO_SHAPE.OVAL, Inches(11.7), Inches(0.4), Inches(1.0), Inches(0.7))\n        shape.fill.solid()\n        shape.fill.fore_color.rgb = rgb(colors[\"accent\"])\n        shape.line.color.rgb = rgb(colors[\"line\"])\n        return shape\n    if zone == \"B1\":\n        shape = slide.shapes.add_shape(MSO_SHAPE.OVAL, Inches(0.4), Inches(6.2), Inches(1.1), Inches(0.9))\n        shape.fill.solid()\n        shape.fill.fore_color.rgb = rgb(colors[\"accent2\"])\n        shape.line.color.rgb = rgb(colors[\"line\"])\n        return shape\n    if zone == \"B2\":\n        shape = slide.shapes.add_shape(MSO_SHAPE.OVAL, Inches(11.7), Inches(6.1), Inches(1.1), Inches(0.9))\n        shape.fill.solid()\n        shape.fill.fore_color.rgb = rgb(colors[\"accent\"])\n        shape.line.color.rgb = rgb(colors[\"line\"])\n        return shape\n    if zone == \"C\":\n        shape = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, Inches(0), Inches(6.75), Inches(13.33), Inches(0.75))\n        shape.fill.solid()\n        shape.fill.fore_color.rgb = rgb(colors[\"zoneC\"])\n        shape.line.color.rgb = rgb(colors[\"line\"])\n        return shape\n    if zone == \"D\":\n        shape = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, Inches(1.0), Inches(1.1), Inches(11.2), Inches(0.15))\n        shape.fill.solid()\n        shape.fill.fore_color.rgb = rgb(colors[\"accent2\"])\n        shape.line.color.rgb = rgb(colors[\"accent2\"])\n        return shape\n    if zone == \"E\":\n        # background cover\n        rect = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, Inches(0), Inches(0), Inches(13.33), Inches(7.5))\n        rect.fill.solid()\n        rect.fill.fore_color.rgb = rgb(colors[\"bg\"])\n        rect.line.color.rgb = rgb(colors[\"bg\"])\n        return rect\n\n# -------------------------------------------------\n# 3) Sample slide builders\n# -------------------------------------------------\ndef make_cover_slide(prs, theme, title, subtitle):\n    slide = prs.slides.add_slide(prs.slide_layouts[6])\n    set_bg(slide, THEMES[theme][\"bg\"])\n    add_zone_decor(slide, theme, \"E\", \"bg\")\n    add_zone_decor(slide, theme, \"A1\", \"corner\")\n    add_zone_decor(slide, theme, \"A2\", \"corner\")\n    add_zone_decor(slide, theme, \"C\", \"baseline\")\n\n    panel = add_panel(slide, Inches(0.7), Inches(1.0), Inches(11.7), Inches(4.7), THEMES[theme][\"panel\"], line_color=THEMES[theme][\"line\"])\n    add_textbox(slide, Inches(1.2), Inches(1.5), Inches(9.2), Inches(1.0), title, \"Playfair Display\", 32, THEMES[theme][\"title\"], True, \"left\")\n    add_textbox(slide, Inches(1.25), Inches(2.6), Inches(8.2), Inches(1.1), subtitle, \"Be Vietnam Pro\", 16, THEMES[theme][\"text\"], False, \"left\")\n    add_zone_decor(slide, theme, \"B2\", \"corner\")\n    return slide\n\ndef make_text_slide(prs, theme, title, bullets, subtitle=None):\n    slide = prs.slides.add_slide(prs.slide_layouts[6])\n    set_bg(slide, THEMES[theme][\"bg\"])\n    add_zone_decor(slide, theme, \"E\", \"bg\")\n    add_zone_decor(slide, theme, \"A1\", \"corner\")\n    add_zone_decor(slide, theme, \"A2\", \"corner\")\n    add_zone_decor(slide, theme, \"C\", \"baseline\")\n    add_zone_decor(slide, theme, \"D\", \"washi\")\n\n    panel = add_panel(slide, Inches(0.8), Inches(1.0), Inches(11.7), Inches(4.8), THEMES[theme][\"panel\"], THEMES[theme][\"line\"], radius=18)\n    add_textbox(slide, Inches(1.2), Inches(1.3), Inches(9.5), Inches(0.6), title, \"Playfair Display\", 26, THEMES[theme][\"title\"], True, \"left\")\n    if subtitle:\n        add_textbox(slide, Inches(1.2), Inches(1.9), Inches(9.0), Inches(0.4), subtitle, \"Be Vietnam Pro\", 12, THEMES[theme][\"text\"], False, \"left\")\n    add_bullets(slide, Inches(1.2), Inches(2.3), Inches(9.0), Inches(2.4), bullets, \"Be Vietnam Pro\", 16, THEMES[theme][\"text\"])\n    return slide\n\ndef make_focus_slide(prs, theme, title, left_text, right_text):\n    slide = prs.slides.add_slide(prs.slide_layouts[6])\n    set_bg(slide, THEMES[theme][\"bg\"])\n    add_zone_decor(slide, theme, \"E\", \"bg\")\n    add_zone_decor(slide, theme, \"A1\", \"corner\")\n    add_zone_decor(slide, theme, \"A2\", \"corner\")\n    add_zone_decor(slide, theme, \"C\", \"baseline\")\n\n    left_panel = add_panel(slide, Inches(0.8), Inches(1.0), Inches(5.7), Inches(4.7), THEMES[theme][\"bg2\"], THEMES[theme][\"line\"], radius=18)\n    right_panel = add_panel(slide, Inches(6.9), Inches(1.0), Inches(5.5), Inches(4.7), THEMES[theme][\"panel\"], THEMES[theme][\"line\"], radius=18)\n\n    add_textbox(slide, Inches(1.1), Inches(1.3), Inches(4.7), Inches(0.7), title, \"Playfair Display\", 24, THEMES[theme][\"title\"], True, \"left\")\n    add_bullets(slide, Inches(1.1), Inches(2.1), Inches(4.6), Inches(2.8), left_text, \"Be Vietnam Pro\", 16, THEMES[theme][\"text\"])\n\n    add_textbox(slide, Inches(7.2), Inches(1.5), Inches(4.2), Inches(0.7), \"Key Takeaway\", \"Be Vietnam Pro\", 18, THEMES[theme][\"title\"], True, \"left\")\n    add_bullets(slide, Inches(7.2), Inches(2.2), Inches(4.1), Inches(2.6), right_text, \"Be Vietnam Pro\", 15, THEMES[theme][\"text\"])\n    return slide\n\n# -------------------------------------------------\n# 4) Theme demo builder\n# -------------------------------------------------\ndef build_sample_gallery(theme_name=\"pastel\"):\n    prs = Presentation()\n    prs.slide_width = Inches(13.333)\n    prs.slide_height = Inches(7.5)\n\n    theme = THEMES[theme_name]\n\n    # Cover\n    make_cover_slide(prs, theme_name, \"Project Presentation\", \"Creative Design System • Modern & Engaging\")\n\n    # Example 1\n    make_text_slide(prs, theme_name, \"Background\", [\n        \"Xây dựng hệ thống thiết kế thống nhất\",\n        \"Dùng màu nền, panel, accent rõ ràng\",\n        \"Mỗi slide có 1 focus point chính\",\n        \"Trang trí tại Zone A/B/C/D/E\"\n    ], \"Design Guidance\")\n\n    # Example 2\n    make_focus_slide(prs, theme_name, \"Problem\", [\n        \"Mất đồng nhất trong màu sắc\",\n        \"Hệ thống vị trí decor chưa rõ\",\n        \"Văn bản dễ tràn hoặc mỏi mắt\"\n    ], [\n        \"Dùng 1 focus card cho từng slide\",\n        \"Highlight theo màu accent\",\n        \"Giảm mật độ chữ và tăng khoảng trắng\"\n    ])\n\n    # Example 3\n    make_text_slide(prs, theme_name, \"Method\", [\n        \"Phân vùng theo Zone A/B/C/D/E\",\n        \"Dùng tối đa 2-3 màu chủ đạo\",\n        \"Text & hình ảnh tách rõ\",\n        \"Nền và panel không đồng màu quá nhiều\"\n    ], \"Layout System\")\n\n    # Example 4\n    make_focus_slide(prs, theme_name, \"Outcome\", [\n        \"Slide rõ ràng hơn\",\n        \"Tạo cảm giác chuyên nghiệp\",\n        \"Dễ đọc, dễ trình bày\"\n    ], [\n        \"Bám đúng mục tiêu học tập\",\n        \"Dễ theo dõi khi trình chiếu\",\n        \"Tăng tương tác và tập trung\"\n    ])\n\n    filename = f\"{theme_name}_sample_gallery.pptx\"\n    prs.save(filename)\n    print(f\"Saved: {filename}\")\n    return filename\n\n# -------------------------------------------------\n# 5) Run sample\n# -------------------------------------------------\nif __name__ == \"__main__\":\n    for theme in [\"pastel\", \"eco\", \"group\", \"chinese\"]:\n        build_sample_gallery(theme)",
