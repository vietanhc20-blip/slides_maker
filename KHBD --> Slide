        "value": "#!/usr/bin/env python3\n# create_pptx.py\n# Tạo PPTX draft dựa trên KHBD & PDS (Academic & Cultural)\n# Yêu cầu: Python 3.x, pip install python-pptx==0.6.21\n#\n# Cách dùng:\n# - Đặt file này cùng thư mục assets/ (tuỳ chọn: chứa ảnh minh họa)\n# - Chạy: python create_pptx.py\n# - Kết quả: PPT_KHBD_DoanVanSongPhan_01-10-2025_draft.pptx\n\nfrom pptx import Presentation\nfrom pptx.util import Pt, Inches\nfrom pptx.dml.color import RGBColor\nimport os\nimport datetime\n\n# --------- Configuration (PDS - Academic & Cultural) ----------\nTITLE_FONT = \"Playfair Display\"    # nếu không có, PowerPoint sẽ dùng fallback\nBODY_FONT = \"Be Vietnam Pro\"       # fallback nếu không có\nFALLBACK_TITLE_FONT = \"Times New Roman\"\nFALLBACK_BODY_FONT = \"Arial\"\n\nCOLORS = {\n    \"background\": (0xF4, 0xEE, 0xDD),  # #F4EEDD\n    \"primary\":    (0x2E, 0x30, 0x33),  # #2E3033\n    \"accent\":     (0x8B, 0x26, 0x1D),  # #8B261D\n    \"text\":       (0x1A, 0x1A, 0x1A),  # #1A1A1A\n}\n\nOUT_FILENAME = \"PPT_KHBD_DoanVanSongPhan_01-10-2025_draft.pptx\"\n\n# ---------- helper functions ----------\ndef rgb(color_tuple):\n    return RGBColor(color_tuple[0], color_tuple[1], color_tuple[2])\n\ndef set_textbox_text(shape, text, font_name=BODY_FONT, size_pt=18, bold=False, color=COLORS[\"text\"]):\n    tf = shape.text_frame\n    tf.clear()\n    p = tf.paragraphs[0]\n    p.text = text\n    r = p.runs[0]\n    try:\n        r.font.name = font_name\n    except Exception:\n        r.font.name = FALLBACK_BODY_FONT\n    r.font.size = Pt(size_pt)\n    r.font.bold = bold\n    r.font.color.rgb = rgb(color)\n\ndef add_bullets(shape, bullets, font_name=BODY_FONT, size_pt=18, color=COLORS[\"text\"]):\n    tf = shape.text_frame\n    tf.clear()\n    for i, b in enumerate(bullets):\n        if i == 0:\n            p = tf.paragraphs[0]\n            p.text = b\n        else:\n            p = tf.add_paragraph()\n            p.text = b\n        r = p.runs[0]\n        try:\n            r.font.name = font_name\n        except Exception:\n            r.font.name = FALLBACK_BODY_FONT\n        r.font.size = Pt(size_pt)\n        r.font.color.rgb = rgb(color)\n        p.level = 0\n\n# ---------- slide_map (tóm tắt nội dung theo quyết định) ----------\n# Mỗi mục: title, content (list of bullets or single text), notes (GV)\nslide_map = [\n    {\"title\":\"Đoạn văn song song và đoạn văn phối hợp\", \"content\":[\"Lớp 8 — Tiết 31,32\",\"01/10/2025\"], \"notes\":\"GV: Chào lớp, kết nối trò chơi Ong non học việc.\"},\n    {\"title\":\"Mục tiêu bài học\", \"content\":[\"Nhận biết đặc điểm & chức năng\",\"Biết cách triển khai đoạn văn song song và phối hợp\",\"Hoàn thành bài tập nhóm và cá nhân\"], \"notes\":\"GV: Bật từng mục một khi giới thiệu.\"},\n    {\"title\":\"Khởi động — Ong non học việc\", \"content\":[\"Câu 1: Em đã được học những kiểu đoạn văn nào?\",\"Câu 2: Khác biệt lớn nhất giữa diễn dịch và quy nạp là gì?\",\"Câu 3: Thế nào là câu chủ đề?\",\"Câu 4: Đoạn diễn dịch/quy nạp phù hợp với loại văn bản nào?\"], \"notes\":\"GV: HS trả lời cá nhân, sau đó 2–3 HS trình bày. Gợi ý đáp án có trong notes.\"},\n    {\"title\":\"Kết nối sang bài mới\", \"content\":[\"Đoạn văn có nhiều cách tổ chức; hôm nay: Song song & Phối hợp.\"], \"notes\":\"GV: Dẫn vào phần học mới, mở SGK trang 68.\"},\n    {\"title\":\"Ví dụ: Đoạn văn 1 (song song) — Trích\", \"content\":[\"(Trích 3–4 câu đại diện từ KHBD)\"], \"notes\":\"GV: Hướng dẫn HS xác định: có câu chủ đề không? Chú ý: mỗi câu đều nêu một điều.\"},\n    {\"title\":\"Phân tích: Đặc điểm đoạn song song\", \"content\":[\"Không có câu chủ đề\",\"Mỗi câu nêu một ý độc lập cùng chủ đề chung\",\"Phù hợp trình bày thông tin khách quan\"], \"notes\":\"GV: Đưa ví dụ minh họa; ghi chú thêm trong notes.\"},\n    {\"title\":\"Ví dụ: Đoạn văn 2 (phối hợp) — Trích\", \"content\":[\"(Trích 3–4 câu đại diện từ KHBD)\"], \"notes\":\"GV: Hỏi HS: câu chủ đề ở đâu? (đầu/ cuối).\"},\n    {\"title\":\"Phân tích: Đặc điểm đoạn phối hợp\", \"content\":[\"Có câu chủ đề (đầu hoặc cuối)\",\"Các câu giữa làm sáng tỏ chủ đề\",\"Cấu trúc tổng hợp - phân tích - tổng hợp\"], \"notes\":\"GV: Trình bày ví dụ minh họa.\"},\n    {\"title\":\"So sánh: Song song vs Phối hợp\", \"content\":[\"Vị trí câu chủ đề | Tính chất | Chức năng | Ví dụ\"], \"notes\":\"GV: Hiện từng hàng khi giảng. Bật On Click.\"},\n    {\"title\":\"Hướng dẫn Phiếu học tập 01\", \"content\":[\"Phiếu 01: Phân tích Đoạn 1 (nhóm)\",\"Hoàn thành phiếu theo checklist (xem notes)\"], \"notes\":\"GV: Chia nhóm, phát phiếu, thời gian 10–15 phút.\"},\n    {\"title\":\"Báo cáo Phiếu 01\", \"content\":[\"Đại diện nhóm trình bày: 2–3 phút mỗi nhóm\"], \"notes\":\"GV: Ghi nhận, khen nhóm hoàn thành nhanh chính xác.\"},\n    {\"title\":\"Hướng dẫn Phiếu học tập 02\", \"content\":[\"Phiếu 02: Phân tích Đoạn 2 (nhóm)\",\"Hoàn thành phiếu theo checklist (xem notes)\"], \"notes\":\"GV: Chia nhóm/luân phiên, thời gian 10–15 phút.\"},\n    {\"title\":\"Báo cáo Phiếu 02\", \"content\":[\"Đại diện nhóm trình bày: 2–3 phút mỗi nhóm\"], \"notes\":\"GV: Nhận xét, so sánh kết quả.\"},\n    {\"title\":\"Luyện tập — Mật thư (vòng 1)\", \"content\":[\"Mật thư: Xác định kiểu đoạn (5 phút mỗi mật thư)\"], \"notes\":\"GV: Phát mật thư, bật timer.\"},\n    {\"title\":\"Luyện tập — Phản hồi & Điều chỉnh\", \"content\":[\"Trình bày mẫu, GV nhận xét, sửa lỗi\"], \"notes\":\"GV: Cho HS rút kinh nghiệm.\"},\n    {\"title\":\"Luyện tập — Câu 2 (SGK trang 68)\", \"content\":[\"Đọc đoạn, xác định kiểu tố chức, nêu cơ sở nhận biết\"], \"notes\":\"GV: HS làm cá nhân, nộp / trình bày.\"},\n    {\"title\":\"Vận dụng (Bài về nhà)\", \"content\":[\"Sưu tầm đoạn văn song song & phối hợp\",\"Hoàn thành bài tập vào vở\"], \"notes\":\"GV: Nêu yêu cầu nộp, tiêu chí chấm.\"},\n    {\"title\":\"Tổng kết & Tiêu chí đánh giá\", \"content\":[\"Tóm tắt 3 điểm chính\",\"Tiêu chí chấm bài nhóm/cá nhân\"], \"notes\":\"GV: Hiện từng bullet để củng cố.\"},\n    {\"title\":\"Phản hồi HS (Reflection)\", \"content\":[\"Em hiểu gì nhất? Em còn thắc mắc gì?\"], \"notes\":\"GV: Thu nhanh phản hồi (1–2 câu).\"},\n    {\"title\":\"Kết thúc — Lời nhắn\", \"content\":[\"Cảm ơn! Nhắc bài về nhà\"], \"notes\":\"GV: Kết thúc tiết.\"}\n]\n\n# ---------- Build presentation ----------\nprs = Presentation()\nprs.slide_width = Inches(13.333)   # 16:9\nprs.slide_height = Inches(7.5)\n\nblank_layout = prs.slide_layouts[6]  # blank layout\n\nfor idx, s in enumerate(slide_map, start=1):\n    slide = prs.slides.add_slide(blank_layout)\n    # background rectangle (color)\n    left = top = Inches(0)\n    width = prs.slide_width\n    height = prs.slide_height\n    # Title textbox\n    title_left, title_top = Inches(0.6), Inches(0.6)\n    title_w, title_h = Inches(11), Inches(1.2)\n    title_box = slide.shapes.add_textbox(title_left, title_top, title_w, title_h)\n    set_textbox_text(title_box, s[\"title\"], font_name=TITLE_FONT, size_pt=32, bold=True, color=COLORS[\"primary\"])\n    # Content box\n    content_left, content_top = Inches(0.6), Inches(2.2)\n    content_w, content_h = Inches(11), Inches(3.5)\n    content_box = slide.shapes.add_textbox(content_left, content_top, content_w, content_h)\n    if isinstance(s[\"content\"], list):\n        # show up to 6 bullets; long text goes to notes only\n        content_bullets = []\n        for item in s[\"content\"]:\n            short = item if len(item) < 160 else item[:157] + \"...\"\n            content_bullets.append(short)\n        add_bullets(content_box, content_bullets, font_name=BODY_FONT, size_pt=20, color=COLORS[\"primary\"])\n    else:\n        set_textbox_text(content_box, s[\"content\"], font_name=BODY_FONT, size_pt=20, color=COLORS[\"primary\"])\n    # Notes\n    notes_slide = slide.notes_slide\n    notes_tf = notes_slide.notes_text_frame\n    full_notes = s.get(\"notes\", \"\")\n    # include original (if exists) and expanded guidance\n    notes_tf.text = full_notes + \"\\n\\n(Full guidance & answers are here.)\"\n    # Optional: placeholder for images (assets)\n    # e.g., try to find asset with name slide_{idx}.png in ./assets/\n    assets_dir = \"assets\"\n    img_name = f\"slide_{idx}.png\"\n    img_path = os.path.join(assets_dir, img_name)\n    if os.path.exists(img_path):\n        pic_left, pic_top = Inches(8.5), Inches(1.8)\n        pic_w = Inches(4); pic_h = Inches(3)\n        slide.shapes.add_picture(img_path, pic_left, pic_top, width=pic_w, height=pic_h)\n\n# Save file\nprs.save(OUT_FILENAME)\nprint(\"Saved draft presentation:\", OUT_FILENAME)",
