        "name": "create_sample_assets.py",
        "value": "#!/usr/bin/env python3\n# create_sample_assets.py\n# Tạo folder assets/ và vài SVG/PNG placeholder mẫu\nimport os, textwrap\nASSETS_DIR = \"assets\"\nos.makedirs(ASSETS_DIR, exist_ok=True)\n\nsvg_templates = {\n    \"corner_leaf.svg\": \"\"\"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400\" height=\"400\">\n<g fill=\"#7A9A95\">\n<path d=\"M40 300 C60 200, 140 160, 200 120 C260 80, 340 60, 360 40 L380 10 L330 30 C250 60, 180 120, 120 190 C80 240, 40 280, 40 300 Z\"/>\n</g>\n</svg>\"\"\",\n    \"washi_tape_01.png\": None,  # we'll create small PNG replacement using text (or leave placeholder)\n    \"washi_tape_02.png\": None,\n    \"washi_tape_03.png\": None,\n    \"baseline_grass.png\": None,\n    \"mascot_turtle.png\": None,\n    \"treasure_chest.png\": None,\n    \"washi_clip.svg\": \"\"\"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"120\" height=\"60\">\n<rect rx=\"6\" ry=\"6\" width=\"120\" height=\"60\" fill=\"#E8D7C3\"/>\n<text x=\"12\" y=\"36\" font-size=\"12\" fill=\"#2E3033\">Washi</text>\n</svg>\"\"\"\n}\n\n# write SVG files\nfor name, content in svg_templates.items():\n    path = os.path.join(ASSETS_DIR, name)\n    if content:\n        with open(path, \"w\", encoding=\"utf-8\") as f:\n            f.write(textwrap.dedent(content))\n        print(\"Wrote\", path)\n    else:\n        # create a tiny placeholder PNG via pillow if available\n        try:\n            from PIL import Image, ImageDraw, ImageFont\n            img = Image.new(\"RGBA\", (600, 200), (230, 225, 210, 255))\n            d = ImageDraw.Draw(img)\n            d.text((10,80), name, fill=(46,48,51))\n            img.save(path.replace(\".png\",\".png\"))\n            print(\"Wrote placeholder\", path)\n        except Exception as e:\n            # fallback: write a text file placeholder\n            with open(path + \".txt\",\"w\",encoding=\"utf-8\") as f:\n                f.write(\"PLACEHOLDER for \" + name)\n            print(\"Wrote text placeholder for\", name)\nprint(\"Assets created in folder:\", ASSETS_DIR)",
