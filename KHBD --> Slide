       ]\n\n    # Render\n    # Slide 1 cover\n    build_cover_slide(prs, theme, title, spec.get(\"theme_label\", \"Bài trình chiếu\"))\n    # Slide 2 objective\n    obj_title, obj_items = sections[1][1], sections[1][2]\n    build_objective_slide(prs, theme, obj_title, obj_items)\n\n    # optional middle slides\n    for idx in range(2, min(len(sections), 5)):\n        name, label, data = sections[idx]\n        if name == \"compare\":\n            build_compare_slide(prs, theme, label, data)\n        elif name == \"content\":\n            left_items = data[0]\n            right_items = data[1] if len(data) > 1 else None\n            build_content_slide(prs, theme, label, left_items, right_items)\n        else:\n            build_summary_slide(prs, theme, label, data)\n\n    # Final summary if not already\n    last_title, last_items = sections[-1][1], sections[-1][2]\n    build_summary_slide(prs, theme, last_title, last_items)\n\n    # If slide count > standard, append extra generic slides\n    while len(prs.slides) < slide_count:\n        slide = make_slide(prs)\n        palette = THEMES[theme]\n        generate_background(slide, theme)\n        add_zone_decor(slide, theme, \"A1\"); add_zone_decor(slide, theme, \"A2\")\n        add_textbox(slide, Inches(1.2), Inches(1.8), Inches(8.0), Inches(0.9), f\"Slide bổ sung {len(prs.slides)}\", \"Playfair Display\", 22, palette[\"title\"], True, \"left\")\n        add_textbox(slide, Inches(1.4), Inches(3.0), Inches(8.5), Inches(1.2), \"Nội dung thêm được tối ưu theo theme phù hợp\", \"Be Vietnam Pro\", 16, palette[\"text\"], False, \"left\")\n\n    out_path = \"generated_presentation.pptx\"\n    prs.save(out_path)\n    return out_path\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Render a slide deck from design spec JSON.\")\n    parser.add_argument(\"--spec\", help=\"JSON file output from theme_selector.py\")\n    parser.add_argument(\"--text\", help=\"Raw text to auto-detect theme and generate slides without spec file\")\n    parser.add_argument(\"--out\", default=\"generated_presentation.pptx\", help=\"Output PPTX file\")\n    args = parser.parse_args()\n\n    if args.spec:\n        spec = load_spec(args.spec)\n    elif args.text:\n        # fallback: generate spec from text by importing theme_selector\n        import theme_selector\n        spec = theme_selector.build_design_spec(args.text)\n    else:\n        # ask for spec or text\n        raw = input(\"Nhập dữ liệu văn bản hoặc đường dẫn JSON spec: \").strip()\n        if raw.endswith(\".json\") and os.path.exists(raw):\n            spec = load_spec(raw)\n        else:\n            import theme_selector\n            spec = theme_selector.build_design_spec(raw)\n\n    # if generated spec path is given, save output to out path\n    prs = Presentation()\n    prs.slide_width = Inches(13.333)\n    prs.slide_height = Inches(7.5)\n\n    # actual build\n    current = build_presentation(spec)\n    if args.out and current != args.out:\n        os.replace(current, args.out)\n    print(f\"Saved presentation: {args.out if args.out else current}\")\n\nif __name__ == \"__main__\":\n    try:\n        main()\n    except Exception as e:\n        import traceback\n        traceback.print_exc()\n        print(f\"ERROR: {e}\")\n```\n\nGợi ý chạy nhanh\n1. Tạo design spec từ file Word/PDF/text:\n```bash\npython theme_selector.py sample.docx --output spec.json\n```\n\n2. Sinh PPTX:\n```bash\npython auto_layout_generator.py --spec spec.json --out generated_presentation.pptx\n```\n\n3. Nếu muốn từ raw text:\n```bash\npython auto_layout_generator.py --text \"Bài giảng về du lịch Việt Nam, văn hóa truyền thống, điểm đến và trải nghiệm\" --out travel_demo.pptx\n```\n\n4. Nếu chưa có ảnh thật:\n- decor_generator sẽ tự tạo nền và shapes để slide vẫn đẹp\n- bạn có thể thay hình thật sau bằng PowerPoint hoặc chèn ảnh vào placeholder\n\nLưu ý:\n- Đây là phiên bản production-ready ở mức cơ bản, nhưng chưa tích hợp OCR cho ảnh hoặc parse PDF cực phức tạp.\n- Nếu bạn có file Word/PDF thật, hệ thống sẽ đọc thành text tốt.\n- Nếu muốn “tự chọn hình ảnh phù hợp theo keyword và tự tạo hình nếu thiếu”, tôi có thể viết tiếp file `image_recommender.py` và `svg_generator.py` để hoàn thiện pipeline.",
